{
  "expo": {
    "name": "Quick Watch",
    "slug": "mother-care",
    "scheme": "quick-watch",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcon-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macdaniel2026.quickwatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quickwatch",
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon-adaptive.png",
        "backgroundColor": "#6F17C1"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0F0E1A"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Quick Watch needs access to your photos so you can add a profile picture and verification documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#6F17C1"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.macdaniel2026.quickwatch",
          "enableGooglePay": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a345584d-739a-4b14-948e-edd989b60854"
      }
    },
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/a345584d-739a-4b14-948e-edd989b60854"
    },
    "owner": "abraham-alizor"
  }
}
