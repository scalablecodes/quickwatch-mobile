# Copy to .env and fill in. Never commit real values to this file.

# Base URL of the QuickWatch API (no trailing slash).
EXPO_PUBLIC_API_URL=https://quickwatch.onrender.com

# Stripe PUBLISHABLE key only (pk_test_… / pk_live_…). Anything prefixed
# EXPO_PUBLIC_ is embedded in the app bundle and readable by anyone.
# The Stripe SECRET key belongs on the server only — never in this repo.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
